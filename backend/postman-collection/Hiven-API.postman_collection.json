		{
			"name": "Auth",
			"item": [
				{
					"name": "register",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"let token = \"\";\r",
									"\r",
									"if (pm.response.code === 201) {\r",
									"    try {\r",
									"        const res = pm.response.json();\r",
									"        token = res.bearer_token || \"\";\r",
									"    }  catch (e) {}\r",
									"}\r",
									"\r",
									"pm.collectionVariables.set(\"token\", token);\r",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\r\n    \"email\": \"samsmith@example.com\",\r\n    \"password\": \"123456\",\r\n    \"firstname\": \"Sam\",\r\n    \"lastname\": \"Smith\",\r\n    \"phone_number\": \"+91100000000\"\r\n}\r\n",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
